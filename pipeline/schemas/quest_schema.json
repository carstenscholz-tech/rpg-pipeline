{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["quest_id", "title", "description", "type", "steps", "rewards"],
  "properties": {
    "quest_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "type": {"type": "string", "enum": ["main", "side", "daily"]},
    "region": {"type": "string"},
    "level_requirement": {"type": "integer", "minimum": 1},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "type", "description"],
        "properties": {
          "step_id": {"type": "integer", "minimum": 1},
          "type": {
            "type": "string",
            "enum": ["talk_to_npc", "go_to_location", "defeat_enemies", "collect_items", "interact_object", "escort_npc", "craft_item"]
          },
          "description": {"type": "string"},
          "target_npc": {"type": "string"},
          "target_zone": {"type": "string"},
          "enemy_type": {"type": "string"},
          "count": {"type": "integer", "minimum": 1},
          "required_item": {"type": "string"},
          "target_object": {"type": "string"},
          "dialogue_id": {"type": "string"}
        }
      }
    },
    "rewards": {
      "type": "object",
      "properties": {
        "xp": {"type": "object", "additionalProperties": {"type": "number"}},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {"type": "string"},
              "quantity": {"type": "integer", "minimum": 1}
            }
          }
        },
        "gold": {"type": "number", "minimum": 0},
        "reputation": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    }
  }
}
