{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "pixel-art-xl.safetensors",
      "model": ["1", 0],
      "clip": ["1", 1],
      "strength_model": 0.75,
      "strength_clip": 0.75
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "{{positive_prompt}}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 1],
      "text": "{{negative_prompt}}"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "batch_size": 1,
      "height": "{{height}}",
      "width": "{{width}}"
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "cfg": 7,
      "denoise": 1,
      "latent_image": ["5", 0],
      "model": ["2", 0],
      "negative": ["4", 0],
      "positive": ["3", 0],
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "seed": "{{seed}}",
      "steps": 25
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["1", 2]
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "rpg_sprite",
      "images": ["7", 0]
    }
  }
}
